{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dinosaurkfb/feishu-bridge-c/references/dialogue-participant-snapshot-v1.schema.json",
  "title": "Feishu Bridge Dialogue Participant Authorization Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "snapshot_id",
    "authorization_revision",
    "captured_at",
    "coordinator_binding_ref",
    "participants"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "feishu_bridge_dialogue_participant_snapshot" },
    "snapshot_id": { "type": "string", "pattern": "^participant_snapshot_[0-9a-f]{24}$" },
    "authorization_revision": { "type": "integer", "minimum": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "coordinator_binding_ref": { "type": "string", "pattern": "^binding_ref_[0-9a-f]{24}$" },
    "participants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "participant_id",
          "kind",
          "roles",
          "subscription_id",
          "binding_ref",
          "local_target_id",
          "allowed_origins",
          "limits"
        ],
        "properties": {
          "participant_id": { "type": "string", "pattern": "^participant_ref_[0-9a-f]{24}$" },
          "kind": { "enum": ["human", "agent"] },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["requester", "host", "peer", "finalizer"] }
          },
          "subscription_id": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^subscription_[0-9a-f]{24}$" }
            ]
          },
          "binding_ref": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^binding_ref_[0-9a-f]{24}$" }
            ]
          },
          "local_target_id": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^(target|local_target)_[0-9a-f]{24}$" }
            ]
          },
          "allowed_origins": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["human_event", "planner_relay"] }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_agent_runs", "resource_units_per_run"],
            "properties": {
              "max_agent_runs": { "type": "integer", "minimum": 1 },
              "resource_units_per_run": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
