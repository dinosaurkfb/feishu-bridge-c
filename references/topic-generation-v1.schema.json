{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dinosaurkfb/feishu-bridge-c/references/topic-generation-v1.schema.json",
  "title": "Feishu Bridge Topic Generation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "binding_id",
    "binding_status",
    "active_generation_id",
    "generations",
    "rotation",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "feishu_bridge_topic_generations" },
    "binding_id": { "type": "string", "minLength": 1 },
    "binding_status": { "enum": ["active", "paused", "retired"] },
    "active_generation_id": { "type": ["string", "null"], "minLength": 1 },
    "generations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/generation" }
    },
    "rotation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/rotation" }
      ]
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "generation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "channel_generation_id",
        "generation",
        "status",
        "root_message_id",
        "session_id",
        "pending_token",
        "claim_expires_at",
        "created_at",
        "activated_at",
        "read_only_at",
        "retired_at"
      ],
      "properties": {
        "channel_generation_id": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["pending", "active", "read-only", "retired"] },
        "root_message_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": ["string", "null"] },
        "pending_token": { "type": ["string", "null"] },
        "claim_expires_at": { "type": ["string", "null"], "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" },
        "activated_at": { "type": ["string", "null"], "format": "date-time" },
        "read_only_at": { "type": ["string", "null"], "format": "date-time" },
        "retired_at": { "type": ["string", "null"], "format": "date-time" },
        "activity": { "$ref": "#/$defs/activity" }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "count_mode",
        "auto_rotate_enabled",
        "auto_rotate_threshold",
        "message_count",
        "counted_event_keys",
        "started_at",
        "threshold_reached_at",
        "last_auto_rotation_attempt_at",
        "auto_rotation_attempts"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "count_mode": { "const": "business_message_v1" },
        "auto_rotate_enabled": { "type": "boolean" },
        "auto_rotate_threshold": { "type": "integer", "minimum": 1 },
        "message_count": { "type": "integer", "minimum": 0 },
        "counted_event_keys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "started_at": { "type": "string", "format": "date-time" },
        "threshold_reached_at": { "type": ["string", "null"], "format": "date-time" },
        "last_auto_rotation_attempt_at": { "type": ["string", "null"], "format": "date-time" },
        "auto_rotation_attempts": { "type": "integer", "minimum": 0 }
      }
    },
    "rotation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["operation_id", "status"],
      "properties": {
        "operation_id": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "preparing",
            "awaiting_claim",
            "completed",
            "failed",
            "cancelled",
            "expired"
          ]
        },
        "pending_generation_id": { "type": ["string", "null"] }
      }
    }
  }
}
